{
  "name": "@termwright/mcp-server",
  "version": "0.0.1",
  "description": "Playwright for terminals - MCP server for AI agents",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "termwright": "./dist/server.js",
    "termwright-web": "./dist/web-server.js"
  },
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "dev:web": "npx tsx src/web-server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:web": "node dist/web-server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "terminal",
    "pty",
    "mcp",
    "automation",
    "ai",
    "claude",
    "playwright",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@termwright/core": "workspace:*",
    "ghostty-web": "^0.3.0",
    "ws": "^8.18.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
