{
  "name": "term-mcp",
  "version": "0.2.0",
  "description": "Puppeteer for terminals - programmatic terminal control for AI agents with libghostty integration",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "term-mcp": "./dist/server.js",
    "term-mcp-web": "./dist/web-server.js"
  },
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "dev:web": "bun run src/web-server.ts",
    "build": "bun build src/index.ts src/server.ts src/web-server.ts --outdir dist --target node --format esm --packages external && tsc --emitDeclarationOnly --outDir dist",
    "start": "node dist/server.js",
    "start:web": "bun run dist/web-server.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "terminal",
    "pty",
    "mcp",
    "automation",
    "testing",
    "puppeteer",
    "cli",
    "ghostty",
    "libghostty"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "nanoid": "^5.0.9",
    "node-pty": "^1.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.2"
}
