{
  "name": "termwright-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Playwright for terminals - programmatic terminal control for AI agents",
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "dev": "npm run dev --workspace=@termwright/mcp-server",
    "dev:web": "npm run dev:web --workspace=@termwright/mcp-server"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
