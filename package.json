{
  "name": "termwright-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Playwright for terminals - programmatic terminal control for AI agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run --filter @termwright/mcp-server dev",
    "dev:web": "bun run --filter @termwright/mcp-server dev:web"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.2"
}
